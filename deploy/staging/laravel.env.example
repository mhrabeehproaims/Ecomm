# TEMPLATE ONLY. Never copy over an existing .env or load against a production DB.
# Replace reserved example domains and provision secrets through the hosting secret manager.
APP_NAME=Vanthara
APP_ENV=staging
APP_KEY=
APP_PREVIOUS_KEYS=
APP_DEBUG=false
APP_URL=https://api.staging.example.invalid
APP_LOCALE=en

DB_CONNECTION=mysql
DB_HOST=STAGING_DATABASE_HOST_REQUIRED
DB_PORT=3306
DB_DATABASE=vanthara_staging
DB_USERNAME=vanthara_staging_app
DB_PASSWORD=
DB_CHARSET=utf8mb4
DB_COLLATION=utf8mb4_unicode_ci

CACHE_STORE=database
CACHE_PREFIX=vanthara_staging
SESSION_DRIVER=database
SESSION_ENCRYPT=true
SESSION_COOKIE=vanthara_staging_admin_session
SESSION_SECURE_COOKIE=true
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=lax
SESSION_DOMAIN=null
QUEUE_CONNECTION=database
DB_QUEUE_RETRY_AFTER=90
FILESYSTEM_DISK=local
# Example Linux path; select an equivalent private durable path for the actual host.
STOREFRONT_DOCUMENT_ROOT=/srv/vanthara/shared/financial-documents

LOG_CHANNEL=daily
LOG_LEVEL=warning
LOG_DAILY_DAYS=14
# Suppress external transports until explicitly configured and accepted using sample recipients.
MAIL_MAILER=array
BROADCAST_CONNECTION=log

# No production/live checkout adapter exists. Keep all rules and payment keys inactive.
STOREFRONT_TEST_CHECKOUT=false
STOREFRONT_TEST_COD=false
STOREFRONT_TEST_SHIPPING_MINOR={}
STOREFRONT_TEST_SHIPPING_TAX_BPS=
STOREFRONT_TEST_POSTAL_CODES=
STOREFRONT_RAZORPAY_TEST_KEY=
STOREFRONT_RAZORPAY_TEST_SECRET=
STOREFRONT_RAZORPAY_WEBHOOK_SECRET=
STOREFRONT_RAZORPAY_PREVIOUS_WEBHOOK_SECRETS=[]
