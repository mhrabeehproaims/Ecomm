# Server-only Laravel origin. No credentials or /api suffix.
LARAVEL_API_ORIGIN=http://localhost:8000
# Public storefront origin used for metadata. Set to the real HTTPS URL at release.
STOREFRONT_URL=http://127.0.0.1:3000
# Required to enable encrypted customer sessions. Generate a random value of at least 32 characters.
STOREFRONT_SESSION_SECRET=
# Isolated-test checkout only; this flag cannot enable production checkout.
STOREFRONT_SANDBOX_TRANSACTIONS=false
# Optional Razorpay TEST key; live keys are rejected. Backend test keys are configured separately.
STOREFRONT_RAZORPAY_TEST_KEY=
# Enable search indexing only after approved copy, stable product URLs and release QA.
STOREFRONT_INDEXABLE=false

# Match Laravel's server-only catalog invalidation secret (32+ characters).
# dev:local supplies an ephemeral shared value to both child processes automatically.
STOREFRONT_CATALOG_REVALIDATE_SECRET=
