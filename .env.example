APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Optional one-time admin provisioning. Supply securely to the seeder process, then remove.
# Never reuse a sample or previously committed password. Existing users are preserved.
VANTHARA_BOOTSTRAP_ADMIN_EMAIL=
VANTHARA_BOOTSTRAP_ADMIN_PASSWORD=

# Checkout remains local/test only. These flags cannot enable production orders.
STOREFRONT_TEST_CHECKOUT=false
STOREFRONT_TEST_COD=false
STOREFRONT_TEST_SHIPPING_MINOR={}
STOREFRONT_TEST_SHIPPING_TAX_BPS=
STOREFRONT_TEST_POSTAL_CODES=
STOREFRONT_RAZORPAY_TEST_KEY=
STOREFRONT_RAZORPAY_TEST_SECRET=
STOREFRONT_RAZORPAY_WEBHOOK_SECRET=
STOREFRONT_RAZORPAY_PREVIOUS_WEBHOOK_SECRETS=[]
# Private durable path outside the public document root (default storage/app/financial-documents).
STOREFRONT_DOCUMENT_ROOT=

# Optional authenticated Next.js catalog invalidation; keep the shared secret server-only.
# Without this integration, the storefront retains bounded timed catalog revalidation.
STOREFRONT_CATALOG_REVALIDATE_URL=
STOREFRONT_CATALOG_REVALIDATE_SECRET=
